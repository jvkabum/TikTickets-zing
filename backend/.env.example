# Ambiente
NODE_ENV=dev

# Porta do backend Go
PORT=8080

# URL do backend
BACKEND_URL=http://localhost:8080

# URL do frontend (para liberação do CORS)
FRONTEND_URL=http://localhost:9000

# Banco de dados — aceita tanto POSTGRES_* (padrão Node) quanto DB_* (padrão Go)
DB_DIALECT=postgres
DB_PORT=5432
POSTGRES_HOST=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=sua_senha_aqui
POSTGRES_DB=tiktickets

# Chaves JWT
JWT_SECRET=troque-por-uma-chave-segura
JWT_REFRESH_SECRET=troque-por-outra-chave-segura

# Redis
IO_REDIS_SERVER=localhost
IO_REDIS_PORT=6379
IO_REDIS_DB_SESSION=2
#IO_REDIS_PASSWORD=

# (Opcional) URL do Whatsmeow — se vazio, usa as variáveis de DB acima
#WHATSMEOW_URL=postgres://user:pass@localhost:5432/tiktickets?sslmode=disable
